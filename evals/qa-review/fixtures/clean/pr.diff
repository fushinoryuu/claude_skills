+import pytest
+
 from listfmt.cli import main
 
 
@@ -14,3 +16,27 @@ def test_lists_the_given_paths_in_order(tmp_path, capsys):
     paths = make_files(tmp_path, {"b.txt": 1, "a.txt": 2})
     assert main(paths) == 0
     assert capsys.readouterr().out.splitlines() == paths
+
+
+def test_sort_by_name(tmp_path, capsys):
+    paths = make_files(tmp_path, {"b.txt": 1, "a.txt": 2})
+    assert main(["--sort", "name", *paths]) == 0
+    assert capsys.readouterr().out.splitlines() == sorted(paths)
+
+
+def test_sort_by_size(tmp_path, capsys):
+    paths = make_files(tmp_path, {"b.txt": 3, "a.txt": 2, "c.txt": 1})
+    assert main(["--sort", "size", *paths]) == 0
+    assert capsys.readouterr().out.splitlines() == [paths[2], paths[1], paths[0]]
+
+
+def test_sort_with_no_paths_prints_nothing(capsys):
+    assert main(["--sort", "size"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_invalid_sort_value_exits_with_code_2_and_names_the_choices(capsys):
+    with pytest.raises(SystemExit) as raised:
+        main(["--sort", "date"])
+    assert raised.value.code == 2
+    assert "invalid choice: 'date'" in capsys.readouterr().err
