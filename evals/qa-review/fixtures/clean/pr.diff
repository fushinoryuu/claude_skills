@@ -3,6 +3,17 @@
 Entry = tuple[str, int]
 
 
+def sort_entries(entries: list[Entry], key: str | None) -> list[Entry]:
+    """Entries ordered by name or by size (smallest first). With key=None the order is unchanged."""
+    if key is None:
+        return list(entries)
+    if key == "name":
+        return sorted(entries, key=lambda entry: entry[0])
+    if key == "size":
+        return sorted(entries, key=lambda entry: entry[1])
+    raise ValueError(f"unknown sort key: {key}")
+
+
