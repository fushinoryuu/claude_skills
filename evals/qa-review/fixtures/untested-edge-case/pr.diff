diff --git a/src/inventory/items.py b/src/inventory/items.py
index 3f18d68..bf72a63 100644
--- a/src/inventory/items.py
+++ b/src/inventory/items.py
@@ -2,7 +2,24 @@
 
 Inventory = dict[str, int]
 
+STACK_LIMIT = 99
+
 
 def total_count(inventory: Inventory) -> int:
     """How many items the player holds, counting every stack."""
     return sum(inventory.values())
+
+
+def add_item(inventory: Inventory, item: str, count: int, limit: int = STACK_LIMIT) -> int:
+    """Add up to `count` of `item`, never going over `limit` in one stack.
+
+    Returns how many did not fit, so the caller can drop them or offer them elsewhere.
+    Adding zero changes nothing. A negative count raises ValueError.
+    """
+    if count < 0:
+        raise ValueError("count must not be negative")
+    room = max(limit - inventory.get(item, 0), 0)
+    added = min(count, room)
+    if added:
+        inventory[item] = inventory.get(item, 0) + added
+    return count - added
