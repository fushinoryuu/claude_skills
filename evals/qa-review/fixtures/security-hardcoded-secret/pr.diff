diff --git a/tests/test_welcome.py b/tests/test_welcome.py
new file mode 100644
index 0000000..82adbeb
--- /dev/null
+++ b/tests/test_welcome.py
@@ -0,0 +1,38 @@
+import pytest
+
+from notify import settings
+from notify.welcome import send_welcome
+
+
+class FakeResponse:
+    def __init__(self, ok=True):
+        self.ok = ok
+
+    def raise_for_status(self):
+        if not self.ok:
+            raise RuntimeError("provider refused the email")
+
+
+class FakeHttp:
+    def __init__(self, ok=True):
+        self.ok = ok
+        self.calls = []
+
+    def post(self, url, headers, json):
+        self.calls.append((url, headers, json))
+        return FakeResponse(self.ok)
+
+
+def test_posts_the_welcome_email_to_the_provider():
+    http = FakeHttp()
+    send_welcome(http, "ana@example.test", "Ana")
+    url, headers, payload = http.calls[0]
+    assert url == settings.MAIL_API_URL
+    assert headers["Authorization"].startswith("Bearer ")
+    assert payload["to"] == "ana@example.test"
+    assert "Ana" in payload["text"]
+
+
+def test_a_refused_email_raises():
+    with pytest.raises(RuntimeError):
+        send_welcome(FakeHttp(ok=False), "ana@example.test", "Ana")
