+++ b/src/notify/welcome.py
@@ -0,0 +1,13 @@
+"""Send the welcome email."""
+
+from notify import settings
+
+
+def send_welcome(http, email: str, name: str) -> None:
+    """Post the welcome email to the mail provider. Raises if the provider refuses it."""
+    response = http.post(
+        settings.MAIL_API_URL,
+        headers={"Authorization": f"Bearer {settings.MAIL_API_KEY}"},
+        json={"to": email, "subject": "Welcome", "text": f"Hello {name}, your account is ready."},
+    )
+    response.raise_for_status()
