 ### `GET /exports/tables`
 
 Returns the names of the tables that can be exported.
+
+### `GET /exports/table?table=<name>&limit=<n>`
+
+Returns `{"rows": [...]}` with up to `limit` rows (default 100, at most 1000) of the table. The table must be one of the names that `GET /exports/tables` returns, otherwise the answer is 400. A `limit` that is not a whole number from 1 to 1000 is also a 400.
diff --git a/src/reports/handlers/export_table.py b/src/reports/handlers/export_table.py
new file mode 100644
index 0000000..8c617ef
--- /dev/null
+++ b/src/reports/handlers/export_table.py
@@ -0,0 +1,21 @@
+"""GET /exports/table?table=<name>&limit=<n>"""
+
+from reports.handlers.list_tables import ALLOWED_TABLES
+
+MAX_LIMIT = 1000
+
+
+def export_table(db, params: dict) -> tuple[int, dict]:
+    """Up to `limit` rows of one of the allowed tables."""
+    table = params.get("table", "")
+    if table not in ALLOWED_TABLES:
+        return 400, {"error": "unknown table", "allowed": list(ALLOWED_TABLES)}
+    try:
+        limit = int(params.get("limit", 100))
+    except ValueError:
+        return 400, {"error": "limit must be a whole number"}
+    if not 1 <= limit <= MAX_LIMIT:
+        return 400, {"error": "limit must be from 1 to 1000"}
+    # The table name comes from ALLOWED_TABLES above, never from the caller's text.
+    rows = db.execute(f"SELECT * FROM {table} LIMIT ?", (limit,)).fetchall()
+    return 200, {"rows": [dict(row) for row in rows]}
