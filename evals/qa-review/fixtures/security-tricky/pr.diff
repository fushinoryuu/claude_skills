diff --git a/tests/test_export_table.py b/tests/test_export_table.py
new file mode 100644
index 0000000..1acc58d
--- /dev/null
+++ b/tests/test_export_table.py
@@ -0,0 +1,59 @@
+import sqlite3
+
+import pytest
+
+from reports.handlers.export_table import MAX_LIMIT, export_table
+from reports.handlers.list_tables import ALLOWED_TABLES
+
+
+@pytest.fixture
+def db():
+    db = sqlite3.connect(":memory:")
+    db.row_factory = sqlite3.Row
+    db.execute("CREATE TABLE orders (id INTEGER PRIMARY KEY, sku TEXT)")
+    db.execute("CREATE TABLE secrets (id INTEGER PRIMARY KEY, note TEXT)")
+    db.executemany("INSERT INTO orders (sku) VALUES (?)", [("A-1",), ("B-2",), ("C-3",)])
+    return db
+
+
+def test_exports_the_rows_of_an_allowed_table(db, signed_in_user):
+    status, body = export_table(db, {"table": "orders", "limit": "2"})
+    assert status == 200
+    assert [row["sku"] for row in body["rows"]] == ["A-1", "B-2"]
+
+
+def test_without_a_limit_it_returns_up_to_100_rows(db):
+    db.executemany("INSERT INTO orders (sku) VALUES (?)", [(f"X-{n}",) for n in range(150)])
+    status, body = export_table(db, {"table": "orders"})
+    assert status == 200
+    assert len(body["rows"]) == 100
+
+
+@pytest.mark.parametrize("limit", ["1", str(MAX_LIMIT)])
+def test_the_smallest_and_largest_limits_are_accepted(db, limit):
+    status, body = export_table(db, {"table": "orders", "limit": limit})
+    assert status == 200
+    assert 1 <= len(body["rows"]) <= int(limit)
+
+
+def test_a_table_that_is_not_allowed_is_a_400_and_the_body_lists_the_allowed_ones(db):
+    status, body = export_table(db, {"table": "secrets"})
+    assert status == 400
+    assert body == {"error": "unknown table", "allowed": list(ALLOWED_TABLES)}
+
+
+def test_a_missing_table_is_a_400(db):
+    status, body = export_table(db, {})
+    assert status == 400
+    assert body["error"] == "unknown table"
+
+
+def test_text_in_place_of_a_table_name_is_a_400(db):
+    status, _ = export_table(db, {"table": "orders; DROP TABLE orders"})
+    assert status == 400
+
+
+@pytest.mark.parametrize("limit", ["0", "-1", str(MAX_LIMIT + 1), "ten"])
+def test_a_bad_limit_is_a_400(db, limit):
+    status, _ = export_table(db, {"table": "orders", "limit": limit})
+    assert status == 400
