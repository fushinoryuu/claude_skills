--- a/src/wordkit.gleam
+++ b/src/wordkit.gleam
@@ -1,6 +1,16 @@
+import gleam/int
 import gleam/string
 
 /// Make the first letter of a word upper case and the rest lower case.
 pub fn capitalize(word: String) -> String {
   string.capitalise(word)
 }
+
+/// Write a count with its word, adding an "s" unless the count is exactly one.
+/// A negative count is written with its sign, for example "-2 items".
+pub fn pluralize(count: Int, word: String) -> String {
+  case count {
+    1 -> "1 " <> word
+    _ -> int.to_string(count) <> " " <> word <> "s"
+  }
+}
