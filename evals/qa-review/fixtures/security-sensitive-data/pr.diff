diff --git a/tests/test_signup.py b/tests/test_signup.py
new file mode 100644
index 0000000..bfd01be
--- /dev/null
+++ b/tests/test_signup.py
@@ -0,0 +1,20 @@
+from accounts.handlers.signup import signup
+from accounts.store import AccountStore
+
+
+def test_creates_an_account_and_returns_201():
+    status, body = signup(AccountStore(), {"email": "ana@example.test", "password": "pw-1"})
+    assert status == 201
+    assert body == {"id": 1, "email": "ana@example.test"}
+
+
+def test_the_password_is_stored_as_a_hash():
+    store = AccountStore()
+    signup(store, {"email": "ana@example.test", "password": "pw-1"})
+    assert store.get(1)["password_hash"] != "pw-1"
+
+
+def test_a_missing_email_or_password_is_a_400():
+    store = AccountStore()
+    assert signup(store, {"email": "ana@example.test"})[0] == 400
+    assert signup(store, {"password": "pw-1"})[0] == 400
