index 0000000..c3cc75b
--- /dev/null
+++ b/src/accounts/handlers/signup.py
@@ -0,0 +1,18 @@
+"""POST /accounts"""
+
+import logging
+
+from accounts.passwords import hash_password
+
+logger = logging.getLogger(__name__)
+
+
+def signup(store, body: dict) -> tuple[int, dict]:
+    """Create an account from the request body. Returns (status code, response body)."""
+    logger.info("signup request: %s", body)
+    email = body.get("email")
+    password = body.get("password")
+    if not email or not password:
+        return 400, {"error": "email and password are required"}
+    account = store.add(email=email, password_hash=hash_password(password))
+    return 201, {"id": account["id"], "email": account["email"]}
