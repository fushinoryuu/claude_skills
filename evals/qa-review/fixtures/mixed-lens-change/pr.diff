+
+
+def cancel_order(orders: dict, order_id: str) -> tuple[int, dict]:
+    """DELETE /orders/{id}"""
+    if order_id not in orders:
+        return 404, {"error": "order not found"}
+    del orders[order_id]
+    return 204, {}
