diff --git a/tests/test_get_invoice.py b/tests/test_get_invoice.py
new file mode 100644
index 0000000..e396286
--- /dev/null
+++ b/tests/test_get_invoice.py
@@ -0,0 +1,21 @@
+from billing.handlers.get_invoice import get_invoice
+from billing.store import InvoiceStore
+
+
+def make_store():
+    store = InvoiceStore()
+    store.add(customer_id=7, total_cents=4200, lines=[{"item": "Plan", "cents": 4200}])
+    return store
+
+
+def test_returns_the_invoice():
+    status, body = get_invoice(make_store(), {"id": 7}, 1)
+    assert status == 200
+    assert body["total_cents"] == 4200
+    assert body["customer_id"] == 7
+
+
+def test_an_unknown_invoice_is_a_404():
+    status, body = get_invoice(make_store(), {"id": 7}, 99)
+    assert status == 404
+    assert body == {"error": "invoice not found"}
