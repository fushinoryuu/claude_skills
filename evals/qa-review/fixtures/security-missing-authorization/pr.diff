@@ -0,0 +1,11 @@
+"""GET /invoices/<id>"""
+
+from billing.store import InvoiceStore
+
+
+def get_invoice(store: InvoiceStore, user: dict, invoice_id: int) -> tuple[int, dict]:
+    """Return the invoice. Returns (status code, response body)."""
+    invoice = store.get(invoice_id)
+    if invoice is None:
+        return 404, {"error": "invoice not found"}
+    return 200, invoice
