+
+
+def truncate_slug(slug: str, max_length: int) -> str:
+    """Shorten a slug to at most max_length characters, cutting at a hyphen when possible.
+
+    The result never ends with a hyphen. A single word longer than max_length is cut at max_length.
+    """
+    if max_length < 1:
+        raise ValueError("max_length must be at least 1")
+    if len(slug) <= max_length:
+        return slug
+    cut = slug[:max_length]
+    if slug[max_length] != "-" and "-" in cut:
+        cut = cut[: cut.rindex("-")]
+    return cut.rstrip("-")
