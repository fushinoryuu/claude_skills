+"""Discounts on prices stored in cents."""
+
+
+def apply_discount(price_cents: int, percent: int) -> int:
+    """The price after taking `percent` off, rounded to the nearest cent (halves round up).
+
+    `percent` must be between 0 and 100, otherwise ValueError is raised.
+    """
+    if not 0 <= percent <= 100:
+        raise ValueError("percent must be between 0 and 100")
+    return (price_cents * (100 - percent) + 50) // 100
