diff --git a/tests/test_search_products.py b/tests/test_search_products.py
new file mode 100644
index 0000000..a2e4af7
--- /dev/null
+++ b/tests/test_search_products.py
@@ -0,0 +1,26 @@
+import sqlite3
+
+from catalog.handlers.search_products import search_products
+
+
+def make_db():
+    db = sqlite3.connect(":memory:")
+    db.row_factory = sqlite3.Row
+    db.execute("CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price_cents INTEGER)")
+    db.executemany(
+        "INSERT INTO products (name, price_cents) VALUES (?, ?)",
+        [("Blue mug", 900), ("Red mug", 950), ("Desk lamp", 2400)],
+    )
+    return db
+
+
+def test_finds_products_by_part_of_the_name():
+    status, body = search_products(make_db(), {"q": "mug"})
+    assert status == 200
+    assert [p["name"] for p in body["products"]] == ["Blue mug", "Red mug"]
+
+
+def test_no_match_gives_an_empty_list():
+    status, body = search_products(make_db(), {"q": "teapot"})
+    assert status == 200
+    assert body == {"products": []}
