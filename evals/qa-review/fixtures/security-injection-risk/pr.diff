@@ -0,0 +1,10 @@
+"""GET /products/search?q=<text>"""
+
+
+def search_products(db, params: dict) -> tuple[int, dict]:
+    """Products whose name contains the `q` parameter, ordered by name."""
+    term = params.get("q", "")
+    rows = db.execute(
+        f"SELECT id, name, price_cents FROM products WHERE name LIKE '%{term}%' ORDER BY name"
+    ).fetchall()
+    return 200, {"products": [dict(row) for row in rows]}
