diff --git a/tests/test_search_receipts.py b/tests/test_search_receipts.py
new file mode 100644
index 0000000..48f082a
--- /dev/null
+++ b/tests/test_search_receipts.py
@@ -0,0 +1,50 @@
+import sqlite3
+
+from billing.handlers.search_receipts import MAX_TERM_LENGTH, search_receipts
+
+
+def make_db():
+    db = sqlite3.connect(":memory:")
+    db.row_factory = sqlite3.Row
+    db.execute("CREATE TABLE receipts (id INTEGER PRIMARY KEY, customer_id INTEGER, memo TEXT, total_cents INTEGER)")
+    db.executemany(
+        "INSERT INTO receipts (customer_id, memo, total_cents) VALUES (?, ?, ?)",
+        [(7, "coffee beans", 500), (7, "mug", 900), (7, "50% off mug", 450), (7, "gift_card", 2000), (8, "coffee machine", 9900)],
+    )
+    return db
+
+
+def test_search_finds_only_the_customers_own_receipts():
+    status, body = search_receipts(make_db(), {"id": 7}, {"q": "coffee"})
+    assert status == 200
+    assert body == {"receipts": [{"id": 1, "memo": "coffee beans", "total_cents": 500}]}
+
+
+def test_percent_and_underscore_are_plain_text():
+    db = make_db()
+    assert [r["memo"] for r in search_receipts(db, {"id": 7}, {"q": "%"})[1]["receipts"]] == ["50% off mug"]
+    assert [r["memo"] for r in search_receipts(db, {"id": 7}, {"q": "_"})[1]["receipts"]] == ["gift_card"]
+
+
+def test_search_treats_quotes_as_plain_text():
+    status, body = search_receipts(make_db(), {"id": 7}, {"q": "' OR '1'='1"})
+    assert status == 200
+    assert body == {"receipts": []}
+
+
+def test_a_missing_or_empty_q_is_a_400():
+    for params in ({}, {"q": ""}):
+        status, body = search_receipts(make_db(), {"id": 7}, params)
+        assert status == 400
+        assert body == {"error": "q is required"}
+
+
+def test_q_of_exactly_the_maximum_length_is_accepted():
+    status, _ = search_receipts(make_db(), {"id": 7}, {"q": "x" * MAX_TERM_LENGTH})
+    assert status == 200
+
+
+def test_a_long_search_text_is_a_400():
+    status, body = search_receipts(make_db(), {"id": 7}, {"q": "x" * (MAX_TERM_LENGTH + 1)})
+    assert status == 400
+    assert body == {"error": "q is too long"}
