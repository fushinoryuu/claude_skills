@@ -0,0 +1,27 @@
+from billing.handlers.get_receipt import get_receipt
+
+
+class FakeStore:
+    def __init__(self):
+        self.items = {1: {"id": 1, "customer_id": 7, "total_cents": 500}}
+
+    def get(self, receipt_id):
+        return self.items.get(receipt_id)
+
+
+def test_a_customer_gets_their_own_receipt():
+    status, body = get_receipt(FakeStore(), {"id": 7}, 1)
+    assert status == 200
+    assert body == {"id": 1, "customer_id": 7, "total_cents": 500}
+
+
+def test_another_customers_receipt_is_a_404():
+    status, body = get_receipt(FakeStore(), {"id": 8}, 1)
+    assert status == 404
+    assert body == {"error": "receipt not found"}
+
+
+def test_an_unknown_receipt_is_a_404_with_the_same_body():
+    status, body = get_receipt(FakeStore(), {"id": 7}, 99)
+    assert status == 404
+    assert body == {"error": "receipt not found"}
