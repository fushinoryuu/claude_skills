@@ -0,0 +1,14 @@
+"""GET /receipts/<id>"""
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def get_receipt(store, user: dict, receipt_id: int) -> tuple[int, dict]:
+    """Return the signed-in customer's receipt. Another customer's receipt looks like a missing one."""
+    receipt = store.get(receipt_id)
+    if receipt is None or receipt["customer_id"] != user["id"]:
+        logger.info("receipt %s not served to customer %s", receipt_id, user["id"])
+        return 404, {"error": "receipt not found"}
+    return 200, receipt
diff --git a/src/billing/handlers/search_receipts.py b/src/billing/handlers/search_receipts.py
new file mode 100644
index 0000000..8761f88
--- /dev/null
+++ b/src/billing/handlers/search_receipts.py
@@ -0,0 +1,15 @@
+"""GET /receipts/search?q=<text>"""
+
+MAX_TERM_LENGTH = 100
+
+
+def search_receipts(db, user: dict, params: dict) -> tuple[int, dict]:
+    """The signed-in customer's receipts whose memo contains the `q` parameter."""
+    term = params.get("q", "")
+    if len(term) > MAX_TERM_LENGTH:
+        return 400, {"error": "q is too long"}
+    rows = db.execute(
+        "SELECT id, memo, total_cents FROM receipts WHERE customer_id = ? AND memo LIKE ? ORDER BY id",
+        (user["id"], f"%{term}%"),
+    ).fetchall()
+    return 200, {"receipts": [dict(row) for row in rows]}
