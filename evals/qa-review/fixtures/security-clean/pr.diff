+"""GET /receipts/<id>"""
+
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def get_receipt(store, user: dict, receipt_id: int) -> tuple[int, dict]:
+    """Return the signed-in customer's receipt. Another customer's receipt looks like a missing one."""
+    receipt = store.get(receipt_id)
+    if receipt is None or receipt["customer_id"] != user["id"]:
+        logger.info("receipt %s not served to customer %s", receipt_id, user["id"])
+        return 404, {"error": "receipt not found"}
+    return 200, receipt
