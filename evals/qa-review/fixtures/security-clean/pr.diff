+++ b/src/billing/handlers/search_receipts.py
@@ -0,0 +1,23 @@
+"""GET /receipts?q=<text>"""
+
+MAX_TERM_LENGTH = 100
+ESCAPE = "!"
+
+
+def escape_like(text: str) -> str:
+    """Make `%` and `_` (and the escape character itself) match as plain text in a LIKE pattern."""
+    return text.replace(ESCAPE, ESCAPE * 2).replace("%", ESCAPE + "%").replace("_", ESCAPE + "_")
+
+
+def search_receipts(db, user: dict, params: dict) -> tuple[int, dict]:
+    """The signed-in customer's receipts whose memo contains the `q` parameter."""
+    term = params.get("q", "")
+    if not term:
+        return 400, {"error": "q is required"}
+    if len(term) > MAX_TERM_LENGTH:
+        return 400, {"error": "q is too long"}
+    rows = db.execute(
+        "SELECT id, memo, total_cents FROM receipts WHERE customer_id = ? AND memo LIKE ? ESCAPE '!' ORDER BY id",
+        (user["id"], f"%{escape_like(term)}%"),
+    ).fetchall()
+    return 200, {"receipts": [dict(row) for row in rows]}
