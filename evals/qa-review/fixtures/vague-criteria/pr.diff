 from collections.abc import Callable
 from dataclasses import dataclass
+from datetime import UTC, datetime, time
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+DEFAULT_QUIET_START = time(22, 0)
+DEFAULT_QUIET_END = time(7, 0)
 
 
 @dataclass(frozen=True)
 class User:
     name: str
     timezone: str = "UTC"
+    quiet_start: time = DEFAULT_QUIET_START
+    quiet_end: time = DEFAULT_QUIET_END
+
+    def __post_init__(self) -> None:
+        # The time zone was never read before quiet hours existed, so check it when the user is created.
+        try:
+            ZoneInfo(self.timezone)
+        except (ZoneInfoNotFoundError, ValueError) as error:
+            raise ValueError(f"unknown time zone: {self.timezone!r}") from error
 
 
 Transport = Callable[[User, str], None]
 
 
-def send(user: User, message: str, transport: Transport) -> bool:
-    """Deliver the message through the transport. Returns True when it was sent."""
+def in_quiet_hours(user: User, now: datetime) -> bool:
+    """True when `now`, an aware datetime, falls inside the user's quiet hours in the user's own time zone.
+
+    The start is included and the end is not. A window whose start is later than its end runs past
+    midnight. If start equals end there are no quiet hours. A naive datetime raises ValueError.
+    """
+    if now.tzinfo is None:
+        raise ValueError("now must be a timezone-aware datetime")
+    local = now.astimezone(ZoneInfo(user.timezone)).time()
+    if user.quiet_start <= user.quiet_end:
+        return user.quiet_start <= local < user.quiet_end
+    return local >= user.quiet_start or local < user.quiet_end
+
+
+def send(user: User, message: str, transport: Transport, now: datetime | None = None) -> bool:
+    """Deliver the message through the transport unless it is the user's quiet hours.
+
+    Returns True when the message was sent, False when it was skipped.
+    """
+    if in_quiet_hours(user, now or datetime.now(UTC)):
+        return False
     transport(user, message)
     return True
