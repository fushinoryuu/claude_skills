index b27f6c2..2a74f4c 100644
--- a/src/notifykit/core.py
+++ b/src/notifykit/core.py
@@ -2,18 +2,42 @@
 
 from collections.abc import Callable
 from dataclasses import dataclass
+from datetime import UTC, datetime, time
+from zoneinfo import ZoneInfo
+
+DEFAULT_QUIET_START = time(22, 0)
+DEFAULT_QUIET_END = time(7, 0)
 
 
 @dataclass(frozen=True)
 class User:
     name: str
     timezone: str = "UTC"
+    quiet_start: time = DEFAULT_QUIET_START
+    quiet_end: time = DEFAULT_QUIET_END
 
 
 Transport = Callable[[User, str], None]
 
 
-def send(user: User, message: str, transport: Transport) -> bool:
-    """Deliver the message through the transport. Returns True when it was sent."""
+def in_quiet_hours(user: User, now: datetime) -> bool:
+    """True when `now`, an aware datetime, falls inside the user's quiet hours in the user's own time zone.
+
+    The start is included and the end is not. A window whose start is later than its end runs past
+    midnight. If start equals end there are no quiet hours.
+    """
+    local = now.astimezone(ZoneInfo(user.timezone)).time()
+    if user.quiet_start <= user.quiet_end:
+        return user.quiet_start <= local < user.quiet_end
+    return local >= user.quiet_start or local < user.quiet_end
+
+
+def send(user: User, message: str, transport: Transport, now: datetime | None = None) -> bool:
+    """Deliver the message through the transport unless it is the user's quiet hours.
+
+    Returns True when the message was sent, False when it was skipped.
+    """
+    if in_quiet_hours(user, now or datetime.now(UTC)):
+        return False
     transport(user, message)
     return True
diff --git a/tests/test_core.py b/tests/test_core.py
index 620be2c..ff286f5 100644
--- a/tests/test_core.py
+++ b/tests/test_core.py
@@ -1,8 +1,52 @@
-from notifykit import User, send
+from datetime import UTC, datetime, time
+
+from notifykit import User, in_quiet_hours, send
+
+
+def at(hour, minute=0):
+    return datetime(2026, 3, 2, hour, minute, tzinfo=UTC)
 
 
 def test_send_delivers_through_the_transport():
     sent = []
     user = User("ana")
-    assert send(user, "hello", lambda u, m: sent.append((u, m))) is True
+    assert send(user, "hello", lambda u, m: sent.append((u, m)), now=at(12)) is True
     assert sent == [(user, "hello")]
+
+
+def test_default_quiet_hours_run_from_22_to_07():
+    user = User("ana")
+    assert in_quiet_hours(user, at(23))
+    assert in_quiet_hours(user, at(3))
+    assert not in_quiet_hours(user, at(12))
+
+
+def test_quiet_hours_include_the_start_and_exclude_the_end():
+    user = User("ana")
+    assert in_quiet_hours(user, at(22, 0))
+    assert not in_quiet_hours(user, at(7, 0))
+    assert in_quiet_hours(user, at(6, 59))
+
+
+def test_quiet_hours_are_configurable_per_user():
+    user = User("ben", quiet_start=time(13, 0), quiet_end=time(15, 0))
+    assert in_quiet_hours(user, at(14))
+    assert not in_quiet_hours(user, at(23))
+
+
+def test_quiet_hours_use_the_users_time_zone():
+    user = User("carla", timezone="America/New_York")
+    assert not in_quiet_hours(user, at(12))  # 08:00 in New York in March
+    assert in_quiet_hours(user, at(3))  # 23:00 the evening before in New York
+
+
+def test_equal_start_and_end_means_no_quiet_hours():
+    user = User("dan", quiet_start=time(8, 0), quiet_end=time(8, 0))
+    assert not in_quiet_hours(user, at(8))
+    assert not in_quiet_hours(user, at(20))
+
+
+def test_send_skips_the_message_in_quiet_hours():
+    sent = []
+    assert send(User("ana"), "hello", lambda u, m: sent.append(m), now=at(23)) is False
+    assert sent == []
