-from notifykit import User, send
+from datetime import UTC, datetime, time
+
+import pytest
+
+from notifykit import User, in_quiet_hours, send
+
+
+def at(hour, minute=0):
+    return datetime(2026, 3, 2, hour, minute, tzinfo=UTC)
 
 
 def test_send_delivers_through_the_transport():
     sent = []
     user = User("ana")
-    assert send(user, "hello", lambda u, m: sent.append((u, m))) is True
+    assert send(user, "hello", lambda u, m: sent.append((u, m)), now=at(12)) is True
     assert sent == [(user, "hello")]
+
+
+def test_default_quiet_hours_run_from_22_to_07():
+    user = User("ana")
+    assert in_quiet_hours(user, at(23))
+    assert in_quiet_hours(user, at(3))
+    assert not in_quiet_hours(user, at(12))
+
+
+def test_quiet_hours_include_the_start_and_exclude_the_end():
+    user = User("ana")
+    assert in_quiet_hours(user, at(22, 0))
+    assert not in_quiet_hours(user, at(7, 0))
+    assert in_quiet_hours(user, at(6, 59))
+
+
+def test_quiet_hours_are_configurable_per_user():
+    user = User("ben", quiet_start=time(13, 0), quiet_end=time(15, 0))
+    assert in_quiet_hours(user, at(14))
+    assert not in_quiet_hours(user, at(23))
+
+
+def test_quiet_hours_use_the_users_time_zone():
+    # On 2 March New York is UTC-5. These two instants have different answers in UTC and in New York.
+    user = User("carla", timezone="America/New_York")
+    assert in_quiet_hours(user, at(8))  # 03:00 in New York, but 08:00 in UTC
+    assert not in_quiet_hours(user, at(23))  # 18:00 in New York, but 23:00 in UTC
+    assert not in_quiet_hours(User("carla"), at(8))
+    assert in_quiet_hours(User("carla"), at(23))
+
+
+def test_unknown_time_zone_is_rejected_when_the_user_is_created():
+    with pytest.raises(ValueError, match="unknown time zone"):
+        User("ana", timezone="Mars/Olympus")
+
+
+def test_naive_datetime_is_rejected():
+    with pytest.raises(ValueError, match="timezone-aware"):
+        in_quiet_hours(User("ana"), datetime(2026, 3, 2, 23, 0))
+
+
+def test_equal_start_and_end_means_no_quiet_hours():
+    user = User("dan", quiet_start=time(8, 0), quiet_end=time(8, 0))
+    assert not in_quiet_hours(user, at(8))
+    assert not in_quiet_hours(user, at(20))
+
+
+def test_send_skips_the_message_in_quiet_hours():
+    sent = []
+    assert send(User("ana"), "hello", lambda u, m: sent.append(m), now=at(23)) is False
+    assert sent == []
