@@ -0,0 +1,10 @@
+from reports.csv_export import to_csv
+
+
+def test_the_csv_has_a_header_and_one_line_per_row():
+    text = to_csv([{"date": "2026-01-05", "cents": 1200}, {"date": "2026-01-09", "cents": 300}])
+    assert text.splitlines() == ["date,cents", "2026-01-05,1200", "2026-01-09,300"]
+
+
+def test_no_rows_gives_only_the_header():
+    assert to_csv([]).splitlines() == ["date,cents"]
