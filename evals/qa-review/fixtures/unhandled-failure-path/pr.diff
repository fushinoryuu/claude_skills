@@ -0,0 +1,41 @@
+import io
+import json
+
+from forecast import client
+
+DAYS = [{"date": "2026-03-02", "summary": "Sunny", "high": 18, "low": 7}]
+
+
+class FakeResponse(io.BytesIO):
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+def fake_urlopen(payload, seen=None):
+    def urlopen(url):
+        if seen is not None:
+            seen.append(url)
+        return FakeResponse(json.dumps(payload).encode())
+
+    return urlopen
+
+
+def test_fetch_forecast_returns_the_days(monkeypatch):
+    monkeypatch.setattr(client, "urlopen", fake_urlopen({"days": DAYS}))
+    assert client.fetch_forecast("Madrid") == DAYS
+
+
+def test_city_is_encoded_in_the_url(monkeypatch):
+    seen = []
+    monkeypatch.setattr(client, "urlopen", fake_urlopen({"days": DAYS}, seen))
+    client.fetch_forecast("New York")
+    assert seen == ["https://weather.example.com/forecast?city=New%20York"]
+
+
+def test_main_prints_the_forecast(monkeypatch, capsys):
+    monkeypatch.setattr(client, "urlopen", fake_urlopen({"days": DAYS}))
+    assert client.main(["Madrid"]) == 0
+    assert capsys.readouterr().out.strip() == "2026-03-02: Sunny, 18/7 C"
