@@ -0,0 +1,24 @@
+"""Fetch a forecast from the weather service and print it."""
+
+import argparse
+import json
+from urllib.parse import quote
+from urllib.request import urlopen
+
+from forecast.render import render_forecast
+
+BASE_URL = "https://weather.example.com"
+
+
+def fetch_forecast(city: str, base_url: str = BASE_URL) -> list[dict]:
+    """The forecast days for a city, as returned by the weather service."""
+    with urlopen(f"{base_url}/forecast?city={quote(city)}") as response:
+        return json.load(response)["days"]
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="forecast", description="Print the forecast for a city.")
+    parser.add_argument("city")
+    args = parser.parse_args(argv)
+    print(render_forecast(fetch_forecast(args.city)))
+    return 0
diff --git a/tests/test_client.py b/tests/test_client.py
new file mode 100644
