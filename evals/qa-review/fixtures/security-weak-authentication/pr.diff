 ## Sign-in
 
 Clients sign in with a session cookie. See `src/gateway/auth/session.py`.
+
+Clients can also send `Authorization: Bearer <token>`. The token is a JWT with the claims `sub` (the user id), `role` and `exp`. `user_from_token` in `src/gateway/auth/tokens.py` returns the user, or None.
diff --git a/src/gateway/auth/tokens.py b/src/gateway/auth/tokens.py
new file mode 100644
index 0000000..c9004c7
--- /dev/null
+++ b/src/gateway/auth/tokens.py
@@ -0,0 +1,14 @@
+"""Bearer tokens."""
+
+import jwt
+
+
+def user_from_token(token: str) -> dict | None:
+    """Return {"id": ..., "role": ...} for a usable token, or None."""
+    try:
+        claims = jwt.decode(token, options={"verify_signature": False})
+    except jwt.PyJWTError:
+        return None
+    if "sub" not in claims or "role" not in claims:
+        return None
+    return {"id": claims["sub"], "role": claims["role"]}
diff --git a/tests/test_tokens.py b/tests/test_tokens.py
new file mode 100644
