+++ b/tests/test_tokens.py
@@ -0,0 +1,20 @@
+import jwt
+
+from gateway.auth.tokens import user_from_token
+
+
+def make_token(**claims):
+    return jwt.encode(claims, "unit-test-key", algorithm="HS256")
+
+
+def test_a_token_gives_the_user_and_role():
+    token = make_token(sub="u-7", role="customer")
+    assert user_from_token(token) == {"id": "u-7", "role": "customer"}
+
+
+def test_a_token_without_a_role_gives_none():
+    assert user_from_token(make_token(sub="u-7")) is None
+
+
+def test_text_that_is_not_a_token_gives_none():
+    assert user_from_token("not-a-token") is None
