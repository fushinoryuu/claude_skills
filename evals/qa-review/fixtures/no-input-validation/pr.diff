 ### `GET /orders/<id>`
 
 Returns the order, or 404 with `{"error": "order not found"}`.
+
+### `POST /orders`
+
+Creates an order from a JSON body with `sku` and `quantity`. Returns 201 with the new order, including its `id`.
diff --git a/src/orders/handlers/create_order.py b/src/orders/handlers/create_order.py
new file mode 100644
index 0000000..768fa54
--- /dev/null
+++ b/src/orders/handlers/create_order.py
@@ -0,0 +1,9 @@
+"""POST /orders"""
+
+from orders.store import OrderStore
+
+
+def create_order(store: OrderStore, body: dict) -> tuple[int, dict]:
+    """Create an order from the request body. Returns (status code, response body)."""
+    order = store.add(sku=body["sku"], quantity=body["quantity"])
+    return 201, order
