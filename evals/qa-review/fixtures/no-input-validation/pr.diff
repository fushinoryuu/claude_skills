@@ -0,0 +1,9 @@
+"""POST /orders"""
+
+from orders.store import OrderStore
+
+
+def create_order(store: OrderStore, body: dict) -> tuple[int, dict]:
+    """Create an order from the request body. Returns (status code, response body)."""
+    order = store.add(sku=body["sku"], quantity=body["quantity"])
+    return 201, order
diff --git a/tests/test_create_order.py b/tests/test_create_order.py
