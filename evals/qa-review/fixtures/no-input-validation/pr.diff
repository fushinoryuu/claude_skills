diff --git a/tests/test_create_order.py b/tests/test_create_order.py
new file mode 100644
index 0000000..1e9e03c
--- /dev/null
+++ b/tests/test_create_order.py
@@ -0,0 +1,20 @@
+from orders.handlers.create_order import create_order
+from orders.routes import ROUTES
+from orders.store import OrderStore
+
+
+def test_creates_an_order_and_returns_201():
+    store = OrderStore()
+    status, body = create_order(store, {"sku": "A-1", "quantity": 2})
+    assert status == 201
+    assert body == {"id": 1, "sku": "A-1", "quantity": 2}
+
+
+def test_the_created_order_is_stored():
+    store = OrderStore()
+    _, body = create_order(store, {"sku": "A-1", "quantity": 2})
+    assert store.get(body["id"]) == body
+
+
+def test_the_route_is_registered():
+    assert ROUTES[("POST", "/orders")] is create_order
